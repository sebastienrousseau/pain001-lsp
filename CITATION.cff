version: "0.0.70"
date-released: "2026-09-13"
license: "Apache-2.0 OR MIT"
repository-code: "https://github.com/sebastienrousseau/pain001-lsp"
url: "https://pain001.com"
keywords:
  - ISO 20022
  - pain.001
  - Language Server Protocol
  - LSP
  - payments
